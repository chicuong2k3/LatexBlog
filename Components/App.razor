@inject IConfiguration Config

<!DOCTYPE html>
<html lang="vi">

<head>
    <UpChrome>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alternative World — nghĩ khác đi về toán học và lập trình" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <link rel="stylesheet" href="/generated/pygments.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/_content/Unpoly.Blazor.Shadcn/toastify/toastify.css" />
    <link rel="stylesheet" href="/css/app.css?v=20260919f" />
    <link rel="stylesheet" href="/_content/Unpoly.Blazor.Shadcn/ui.safari15.css" />
    <link rel="stylesheet" href="/css/site.css?v=20260919g" />
    <link rel="alternate" type="application/rss+xml" title="Alternative World RSS" href="/rss.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#fdf1f6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    @* Safari 15 compat for Unpoly.Blazor.Shadcn — must load before unpoly.min.js. *@
    <script src="/_content/Unpoly.Blazor.Shadcn/compat/safari15-shim.js"></script>
    <script src="/_content/Unpoly.Blazor.Shadcn/compat/popover.iife.min.js"></script>
    <script src="/_content/Unpoly.Blazor.Shadcn/compat/css-has-pseudo.js"></script>
    <script src="/_content/Unpoly.Blazor.Shadcn/compat/has-pseudo-boot.js"></script>
    <UnpolyHead />
    <script src="/_content/Unpoly.Blazor.Shadcn/ui.js" defer></script>
    </UpChrome>
    <HeadOutlet />
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" defer></script>
</head>

<body>
    @((MarkupString)@"<!--
THESIS: math is the loudest thing on the page - a formula glows neon while the rest of the blog stays quiet and readable; the category default of a doc-site column of grey cards is refused for street-night energy.
OWN-WORLD: pale sakura ground, sakura-pink neon as the single saturated accent, violet counter-accent, hairline scanline veil, outlined post numerals, Bricolage Grotesque display over Space Grotesk body, stroke-drawn sakura blossom mark.
FIRST VIEWPORT: bold two-line headline with two glowing words, latest post in a neon-edged featured card beside a live rotation matrix.
HONEST RISK: the neon register can read loud for readers of long math prose; the prose keeps the quiet end of the palette so reading stays calm.
-->")
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <path id="lb-petal" d="M0 0 C-13 -9 -19 -29 -11 -40 C-7 -45 -2 -48 0 -42 C2 -48 7 -45 11 -40 C19 -29 13 -9 0 0 Z" />
            <symbol id="lb-blossom" viewBox="0 0 100 100">
                <ellipse cx="50" cy="50" rx="44" ry="17" transform="rotate(-18 50 50)"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="1 5.5" stroke-linecap="round" opacity=".8" />
                <g fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round">
                    <use href="#lb-petal" transform="translate(50 50) rotate(0)" />
                    <use href="#lb-petal" transform="translate(50 50) rotate(72)" />
                    <use href="#lb-petal" transform="translate(50 50) rotate(144)" />
                    <use href="#lb-petal" transform="translate(50 50) rotate(216)" />
                    <use href="#lb-petal" transform="translate(50 50) rotate(288)" />
                </g>
                <circle cx="50" cy="50" r="4.5" fill="currentColor" />
            </symbol>
            <symbol id="lb-arrow" viewBox="0 0 24 24">
                <path d="M5 12h13 M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </symbol>
        </defs>
    </svg>
    <Routes />
    <script>
        window.__SUPABASE__ = { url: "@Config["Supabase:Url"]", anonKey: "@Config["Supabase:AnonKey"]" };
    </script>
    <script src="/_content/Unpoly.Blazor.Shadcn/toastify/toastify.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
    <script src="/js/site.js?v=20260919e"></script>
    <script src="/js/comments.js?v=20260919d"></script>
    <script>
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.register("/sw.js").catch(function () {});
            // Reload once when a NEW service worker takes over (fresh deploy),
            // so the user sees new content immediately instead of on 2nd load.
            var hadController = !!navigator.serviceWorker.controller;
            navigator.serviceWorker.addEventListener("controllerchange", function () {
                if (hadController) location.reload();
                hadController = true;
            });
        }
    </script>
</body>

</html>
