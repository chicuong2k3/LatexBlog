@page "/posts/{slug}"
@using System.Text.RegularExpressions
@using System.Text.Json
@inject PostStore PostStore
@inject IHttpContextAccessor HttpContextAccessor

@if (PostMeta is null || (Html is null && DbBody is null))
{
    <PageTitle>Không tìm thấy trang</PageTitle>
    <NotFoundBlock />
}
else
{
    <PageTitle>@PostMeta.Title — Alternative World</PageTitle>
    <HeadContent>
        <meta property="og:title" content="@PostMeta.Title" />
        <meta property="og:description" content="@PostMeta.Summary" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="@PostUrl" />
        <meta property="og:image" content="@CoverUrl" />
        <script type="application/ld+json">@((MarkupString)ArticleJsonLd)</script>
        <script type="module" src="/js/page-layout.js?v=20260821a"
                data-page-layout
                data-heading=".lb-post-head h1"></script>
    </HeadContent>

    <article class="lb-post-page" data-slug="@PostMeta.Slug">
        <header class="lb-post-head">
            <h1>@PostMeta.Title</h1>
            <p class="lb-post-meta">Đăng ngày @PostMeta.Date · @ReadMinutes phút đọc</p>
            <div class="lb-post-tags">
                @foreach (var tag in PostMeta.Tags)
                {
                    <TagBadge Tag="@tag" />
                }
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(PostMeta.Tldr))
        {
            <Alert Class="lb-tldr" aria-label="Tóm tắt">
                <AlertTitle><strong>TL;DR</strong></AlertTitle>
                <AlertDescription><p>@PostMeta.Tldr</p></AlertDescription>
            </Alert>
        }

        @if (Toc.Count > 0)
        {
            <nav class="lb-toc" aria-label="Mục lục">
                <strong>Mục lục</strong>
                <ul>
                    @foreach (var entry in Toc)
                    {
                        <li>
                            <Button Href="@($"#{entry.Id}")" Variant="link" Size="sm"
                                    Class="h-auto justify-start whitespace-normal p-0 text-left">@entry.Text</Button>
                        </li>
                    }
                </ul>
            </nav>
        }

        @if (Html is not null)
        {
            <div class="lb-prose">
                @((MarkupString)Html)
            </div>
        }
        else if (DbBody is not null)
        {
            <div class="lb-prose" data-md="@JsonSerializer.Serialize(DbBody)"></div>
        }

        <PostActions Slug="@PostMeta.Slug" Title="@PostMeta.Title" />

        @if (Related.Count > 0)
        {
            <aside class="lb-related" aria-label="Bài viết liên quan">
                <h2>Bài viết liên quan</h2>
                <ItemGroup Class="lb-related__list">
                    @foreach (var p in Related)
                    {
                        <Item Href="@($"/posts/{p.Slug}")" Variant="outline" Size="sm" Class="lb-related__item">
                            <ItemContent>
                                <ItemTitle>@p.Title</ItemTitle>
                                <ItemDescription Class="lb-related__tags">@string.Join(" · ", p.Tags.Select(t => "#" + t))</ItemDescription>
                            </ItemContent>
                        </Item>
                    }
                </ItemGroup>
            </aside>
        }

        <CommentSection Slug="@PostMeta.Slug" />

        <ButtonGroup Class="lb-hlmenu" role="menu" hidden>
            <Button Type="button" Variant="ghost" Size="sm" role="menuitem" data-act="hl-highlight">Tô sáng</Button>
            <Button Type="button" Variant="ghost" Size="sm" role="menuitem" data-act="hl-note">Ghi chú</Button>
            <Button Type="button" Variant="ghost" Size="sm" role="menuitem" data-act="hl-share">Chia sẻ đoạn này</Button>
        </ButtonGroup>
        <Card Class="lb-hlnote gap-3 py-3" role="dialog" aria-label="Ghi chú" hidden>
            <div class="lb-rte">
                <RteToolbar />
                <div class="lb-rte__area lb-noteview__edit" contenteditable="true" placeholder="Viết ghi chú cho đoạn này…"></div>
            </div>
            <div class="lb-hlnote__actions">
                <Button Type="button" Size="sm" data-act="note-save">Lưu</Button>
                <Button Type="button" Variant="ghost" Size="sm" data-act="note-cancel">Hủy</Button>
            </div>
        </Card>

        <Card Class="lb-noteview gap-0 py-3" role="dialog" aria-label="Ghi chú" hidden>
            <div class="lb-noteview__inner" data-f="view">
                <div class="lb-noteview__body" data-f="body"></div>
                <div class="lb-noteview__actions">
                    <Button Type="button" Size="sm" data-act="view-edit">Sửa</Button>
                    <Button Type="button" Variant="ghost" Size="sm" data-act="view-close">Đóng</Button>
                </div>
            </div>
            <div class="lb-noteview__inner" data-f="edit" hidden>
                <div class="lb-rte">
                    <RteToolbar />
                    <div class="lb-rte__area lb-noteview__edit" contenteditable="true"></div>
                </div>
                <div class="lb-noteview__actions">
                    <Button Type="button" Size="sm" data-act="view-save">Lưu</Button>
                    <Button Type="button" Variant="ghost" Size="sm" data-act="view-cancel">Hủy</Button>
                </div>
            </div>
        </Card>
    </article>
}


@code {
    private static readonly Regex HeadingRegex = new(
        @"<h([1-3])\s+id=""([^""]+)""[^>]*>(.*?)</h\1>",
        RegexOptions.IgnoreCase | RegexOptions.Singleline);

    [Parameter] public string? Slug { get; set; }

    private PostMeta? PostMeta;
    private string? Html;
    private string? DbBody;
    private List<TocEntry> Toc { get; } = new();

    private string PostUrl =>
        PostMeta is null || HttpContextAccessor.HttpContext is not { } ctx
            ? "/"
            : $"{ctx.Request.Scheme}://{ctx.Request.Host}/posts/{PostMeta.Slug}";

    private string ArticleJsonLd
    {
        get
        {
            if (PostMeta is null) return "{}";
            // JsonObject (not an anonymous type) so property names like "@context"/"@type"
            // — invalid C# identifiers — can be used directly, no post-hoc string patching.
            var node = new System.Text.Json.Nodes.JsonObject
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "BlogPosting",
                ["headline"] = PostMeta.Title,
                ["description"] = PostMeta.Summary,
                ["datePublished"] = PostMeta.Date,
                ["dateModified"] = PostMeta.Date,
                ["keywords"] = string.Join(", ", PostMeta.Tags),
                ["image"] = CoverUrl,
                ["mainEntityOfPage"] = new System.Text.Json.Nodes.JsonObject
                {
                    ["@type"] = "WebPage",
                    ["@id"] = PostUrl,
                },
                ["author"] = new System.Text.Json.Nodes.JsonObject
                {
                    ["@type"] = "Organization",
                    ["name"] = "Alternative World",
                },
                ["publisher"] = new System.Text.Json.Nodes.JsonObject
                {
                    ["@type"] = "Organization",
                    ["name"] = "Alternative World",
                },
                ["inLanguage"] = "vi",
            };
            return node.ToJsonString();
        }
    }

    private string CoverUrl =>
        PostMeta is null || HttpContextAccessor.HttpContext is not { } ctx
            ? ""
            : $"{ctx.Request.Scheme}://{ctx.Request.Host}/cover/{PostMeta.Slug}.svg";

    private int ReadMinutes
    {
        get
        {
            var text = DbBody ?? (Html is null ? "" : Regex.Replace(Html, "<[^>]+>", " "));
            var words = Regex.Matches(text, @"\S+").Count;
            return Math.Max(1, (int)Math.Ceiling(words / 200.0));
        }
    }

    private IReadOnlyList<PostMeta> Related =>
        PostMeta is null
            ? Array.Empty<PostMeta>()
            : PostStore.All
                .Where(p => p.Slug != PostMeta.Slug &&
                            p.Tags.Any(t => PostMeta.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)))
                .OrderByDescending(p => p.Tags.Count(t => PostMeta.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)))
                .ThenBy(p => p.Date)
                .Take(3)
                .ToList();

    protected override void OnParametersSet()
    {
        PostMeta = Slug is null ? null : PostStore.GetMeta(Slug);
        Html = PostMeta is null ? null : PostStore.GetHtml(PostMeta.Slug);
        DbBody = PostMeta is null ? null : PostStore.GetDbBody(PostMeta.Slug);
        Toc.Clear();
        if (Html is not null)
            Toc.AddRange(ExtractToc(Html));
        if (PostMeta is null && HttpContextAccessor.HttpContext is { } ctx)
            ctx.Response.StatusCode = StatusCodes.Status404NotFound;
    }

    private static IEnumerable<TocEntry> ExtractToc(string html)
    {
        foreach (Match m in HeadingRegex.Matches(html))
        {
            var text = Regex.Replace(m.Groups[3].Value, "<[^>]+>", "");
            text = System.Net.WebUtility.HtmlDecode(text).Trim();
            if (text.Length == 0)
                continue;
            yield return new TocEntry(m.Groups[2].Value, text);
        }
    }

    private sealed record TocEntry(string Id, string Text);
}
