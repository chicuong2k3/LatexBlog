@page "/search"
@inject PostStore PostStore

<PageTitle>Tìm kiếm - Alternative World</PageTitle>
<HeadContent>
    <script type="module" src="/js/page-layout.js?v=20260821a"
            data-page-layout
            data-masonry="#search-results .lb-post-list"
            data-heading=".lb-page-head h1"></script>
</HeadContent>
<header class="lb-page-head">
    <h1>Tìm kiếm</h1>
    <p>Gõ để tìm theo tiêu đề, tóm tắt hoặc thẻ.</p>
</header>
<input type="search"
       name="q"
       class="lb-field"
       placeholder="Tìm kiếm bài viết…"
       autocomplete="off"
       value="@CurrentQ"
       form="lb-search-form" />
<form id="lb-search-form" method="get" action="/search"
      up-target="#search-results" up-autosubmit up-watch-delay="300"></form>
<div id="search-results" class="lb-search-results">
    <SearchResults Q="@CurrentQ" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private string CurrentQ => Q ?? "";
}
