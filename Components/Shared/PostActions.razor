@* Views, like and share for one post. Bound by the .lb-actions[data-slug] compiler in comments.js. *@
<div class="lb-actions" data-slug="@Slug" data-title="@Title">
    <Badge Variant="outline" Class="lb-actions__btn lb-actions__btn--static" aria-label="Lượt xem">
        <Icon Name="eye" />
        <span data-f="views">0</span>
    </Badge>

    <Button Type="button" Variant="outline" Size="sm" Class="lb-actions__btn" data-act="like" aria-label="Thích">
        <Icon Name="heart" data-f="heart-off" />
        <Icon Name="heart" fill="currentColor" data-f="heart-on" hidden />
        <span data-f="likes">0</span>
    </Button>

    <div class="lb-actions__sharewrap">
        <Button Type="button" Variant="outline" Size="sm" Class="lb-actions__btn" data-act="share" aria-expanded="false" aria-label="Chia sẻ">
            @* Lucide "share-2" and "link" are not in the library's icon set; drawn inline. *@
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Chia sẻ
        </Button>

        <Card Class="lb-share gap-0 py-1" role="menu" hidden>
            <Button Type="button" Variant="ghost" Size="sm" Class="lb-share__item justify-start" role="menuitem" data-act="copy-link">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                <span>Sao chép liên kết</span>
            </Button>
            @* External share links: up-follow="false" keeps Unpoly from trying to swap them in. *@
            <Button Href="#" Variant="ghost" Size="sm" Class="lb-share__item justify-start" role="menuitem" data-share="facebook" target="_blank" rel="noopener" up-follow="false">Facebook</Button>
            <Button Href="#" Variant="ghost" Size="sm" Class="lb-share__item justify-start" role="menuitem" data-share="x" target="_blank" rel="noopener" up-follow="false">X</Button>
            <Button Href="#" Variant="ghost" Size="sm" Class="lb-share__item justify-start" role="menuitem" data-share="whatsapp" target="_blank" rel="noopener" up-follow="false">WhatsApp</Button>
        </Card>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
}
