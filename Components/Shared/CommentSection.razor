@* Comment thread for one post. Bound by the .lb-comments[data-slug] compiler in comments.js,
   which renders each comment from <template data-tpl="comment">. Forms are up-submit="false":
   comments.js posts them to Supabase, Unpoly must not. *@
<section class="lb-comments" data-slug="@Slug" aria-label="Bình luận">
    <h2 class="lb-comments__title">Bình luận</h2>

    <p class="lb-comments__hint" data-f="off" hidden>Bình luận chưa được bật trên blog này.</p>

    <div data-f="on" hidden>
        <div class="lb-comments__auth" data-auth="out" hidden>
            <Button Type="button" Variant="outline" data-auth-action="sign-in">
                <GoogleMark />
                Đăng nhập bằng Google
            </Button>
        </div>

        <form class="lb-comments__form" data-form="main" up-submit="false" data-auth="in" hidden>
            <span class="lb-comments__who">Bình luận với tư cách: <strong data-auth-text="displayName"></strong></span>

            <div class="lb-rte">
                <RteToolbar Label="Bình luận" IconSize="14" />
                <div class="lb-rte__area" contenteditable="true" data-rte="main" placeholder="Viết bình luận…"></div>
            </div>

            <div class="lb-comments__actions">
                <Button Type="submit" data-busy-disable>Gửi bình luận</Button>
            </div>
        </form>

        <Alert Variant="destructive" Class="lb-comments__error" data-f="error" hidden>
            <AlertDescription data-f="error-text"></AlertDescription>
        </Alert>
        <p class="lb-comments__hint" data-f="loading"><Spinner /> Đang tải bình luận…</p>

        <ul class="lb-comments__list" data-f="list"></ul>

        <Button Type="button" Variant="outline" Size="sm" Class="lb-comments__more" data-act="more" hidden>
            Xem thêm bình luận <span data-f="remaining"></span>
        </Button>

        <p class="lb-comments__hint" data-f="empty" hidden>Chưa có bình luận nào. Hãy là người đầu tiên.</p>
    </div>

    <template data-tpl="comment">
        <li class="lb-comment">
            <div class="lb-comment__head">
                <Avatar Class="lb-comment__avatar">
                    <AvatarImage data-f="avatar" loading="lazy" />
                </Avatar>
                <div class="lb-comment__meta">
                    <a class="lb-comment__author" data-f="author"></a>
                    <span class="lb-comment__when">
                        <time data-f="when"></time>
                        <span class="lb-comment__edited" data-f="edited" hidden>(đã sửa)</span>
                    </span>
                </div>
            </div>
            <div class="lb-comment__body" data-f="body"></div>
            <div class="lb-comment__actions" data-f="actions">
                <Button Type="button" Variant="outline" Size="xs" Class="lb-comment__reply" data-act="delete">Xóa</Button>
                <Button Type="button" Variant="outline" Size="xs" Class="lb-comment__reply" data-act="edit">Sửa</Button>
                <Button Type="button" Variant="outline" Size="xs" Class="lb-comment__reply" data-act="reply">Trả lời</Button>
            </div>
            <form class="lb-comments__editform" data-form="edit" data-f="editform" up-submit="false" hidden>
                <div class="lb-rte">
                    <RteToolbar />
                    <div class="lb-rte__area" contenteditable="true"></div>
                </div>
                <div class="lb-comments__actions">
                    <Button Type="submit" Size="sm" data-busy-disable>Lưu</Button>
                    <Button Type="button" Variant="ghost" Size="sm" data-act="cancel-edit">Hủy</Button>
                </div>
            </form>
            <form class="lb-comments__replyform" data-form="reply" data-f="replyform" up-submit="false" hidden>
                <div class="lb-rte lb-rte--sm">
                    <RteToolbar Label="Trả lời" />
                    <div class="lb-rte__area" contenteditable="true" data-rte="reply" placeholder="Trả lời bình luận…"></div>
                </div>
                <Button Type="submit" Size="sm" data-busy-disable>Gửi trả lời</Button>
            </form>
        </li>
    </template>
</section>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = default!;
}
