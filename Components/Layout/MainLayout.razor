@inherits LayoutComponentBase

@* Behaviour lives in wwwroot/js (site.js: nav, search; comments.js: auth, notifications),
   bound through up.compiler on the classes / data-* hooks below. *@
<UpChrome Provides=".lb-nav, .lb-notif__badge, #lb-search-results">
<div class="lb-nav">
    <div id="lb-progress" class="lb-progress" aria-hidden="true"></div>
    <nav class="lb-wrap lb-nav-in">
        <a href="/" class="lb-brand">
            <svg class="lb-brand__mark" aria-hidden="true"><use href="#lb-blossom" /></svg>
            Alternative World
        </a>

        <Button Type="button" Variant="ghost" Size="icon" Class="lb-nav__toggle"
                data-lb-menu-toggle aria-expanded="false" aria-label="Mở menu">
            <Icon Name="menu" Class="size-5" />
        </Button>

        <div class="lb-nav-panel">
        <ul class="lb-nav-links">
            <li><Button Href="/" Variant="link" Size="sm" Class="px-0">Trang chủ</Button></li>
            <li><Button Href="/tags/toan" Variant="link" Size="sm" Class="px-0">Thẻ</Button></li>
        </ul>

        <div class="lb-nav-right">
            <Button Type="button" Variant="ghost" Size="icon-sm" Class="lb-nav-icon"
                    data-lb-search-open aria-expanded="false" aria-label="Tìm kiếm">
                <Icon Name="search" />
            </Button>

            <div class="lb-notif" data-auth="in" hidden>
                <Button Type="button" Variant="ghost" Size="icon-sm" Class="lb-nav-icon"
                        data-act="notif-toggle" aria-expanded="false" aria-label="Thông báo">
                    @* Lucide "bell" is not in the library's icon set; drawn inline. *@
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <Badge Class="lb-notif__badge" hidden></Badge>
                </Button>
                <Card Class="lb-notif__panel gap-0 py-0" role="menu" aria-label="Thông báo" hidden>
                    <CardHeader Class="lb-notif__head">
                        <CardTitle>Thông báo</CardTitle>
                        <CardAction>
                            <Button Type="button" Variant="link" Size="xs" Class="lb-notif__readall" data-act="read-all" hidden>Đọc hết</Button>
                        </CardAction>
                    </CardHeader>
                    <p class="lb-notif__empty" data-f="empty">Chưa có thông báo.</p>
                    <div data-f="items"></div>
                    <template data-tpl="notif">
                        <Item Href="#" Size="sm" Class="lb-notif__item">
                            <ItemMedia>
                                <Avatar Size="sm" Class="size-[26px]">
                                    <AvatarImage Class="lb-avatar lb-avatar--xs" data-f="avatar" loading="lazy" />
                                </Avatar>
                            </ItemMedia>
                            <ItemContent Class="lb-notif__text">
                                <ItemTitle data-f="name"></ItemTitle>
                                <ItemDescription data-f="text"></ItemDescription>
                            </ItemContent>
                            <time data-f="when"></time>
                        </Item>
                    </template>
                </Card>
            </div>

            <Button Type="button" Variant="outline" Size="sm" Class="lb-nav-login" data-auth="out" data-auth-action="sign-in" aria-label="Đăng nhập" hidden>
                <GoogleMark Size="16" />
                <span class="lb-nav-login__text">Đăng nhập</span>
            </Button>
            <div class="lb-nav-user" data-auth="in" hidden>
                <Button Href="/profile" Variant="ghost" Size="sm" Class="lb-nav-user__link">
                    <Avatar Size="sm" Class="size-[26px]">
                        <AvatarImage Class="lb-avatar" data-auth-src="avatar" loading="lazy" />
                    </Avatar>
                    <span class="lb-nav-user__name" data-auth-text="displayName"></span>
                </Button>
                <Button Type="button" Variant="ghost" Size="icon-sm" Class="lb-nav-icon" data-auth-action="sign-out" aria-label="Đăng xuất" title="Đăng xuất">
                    <Icon Name="log-out" />
                </Button>
            </div>

        </div>
        </div>
    </nav>

    <div class="lb-searchmodal" role="dialog" aria-modal="true" aria-label="Tìm kiếm" hidden>
        <Card Class="lb-searchmodal__panel gap-0 py-0">
            <div class="lb-searchmodal__modes" role="tablist">
                <Button Type="button" Variant="ghost" Size="sm" role="tab" Class="is-active"
                        data-lb-search-mode="posts" aria-selected="true">Tìm kiếm</Button>
                <Button Type="button" Variant="ghost" Size="sm" role="tab"
                        data-lb-search-mode="comments" aria-selected="false">Tìm trong bình luận</Button>
            </div>
            <div data-lb-search-pane="posts">
                <div class="lb-searchmodal__bar">
                    <form method="get" action="/search" class="lb-searchmodal__form">
                        <InputGroup>
                            <InputGroupAddon><Icon Name="search" /></InputGroupAddon>
                            <InputGroupControl Class="lb-searchmodal__input" Type="search" name="q"
                                               placeholder="Tìm kiếm bài viết…" autocomplete="off" />
                        </InputGroup>
                    </form>
                    <Button Type="button" Variant="ghost" Size="icon-sm" Class="lb-nav-icon" data-lb-search-close aria-label="Đóng">
                        <Icon Name="x" />
                    </Button>
                </div>
                <div id="lb-search-results" class="lb-searchmodal__results"></div>
            </div>
            <div data-lb-search-pane="comments" class="lb-searchmodal__cmode" hidden>
                <div class="lb-searchmodal__bar">
                    <InputGroup>
                        <InputGroupAddon><Icon Name="search" /></InputGroupAddon>
                        <InputGroupControl Class="lb-searchmodal__input" Type="search" data-lb-cq placeholder="Tìm trong bình luận" />
                    </InputGroup>
                </div>
                <ItemGroup Class="lb-searchmodal__results" data-lb-cresults></ItemGroup>
                <template data-tpl="cresult">
                    <Item Href="#" Size="sm" Class="lb-cresult">
                        <ItemContent>
                            <ItemTitle Class="lb-cresult__body" data-f="body"></ItemTitle>
                            <ItemDescription Class="lb-cresult__meta" data-f="meta"></ItemDescription>
                        </ItemContent>
                    </Item>
                </template>
            </div>
        </Card>
    </div>

    <Button Type="button" Variant="outline" Size="icon" id="lb-top" Class="lb-top" aria-label="Về đầu trang">
        <Icon Name="arrow-up" />
    </Button>
</div>


</UpChrome>

<main class="lb-wrap lb-main">
    @Body
</main>

<UpChrome>
<footer class="lb-footer">
    <div class="lb-wrap lb-footer-in">
        <span><svg class="lb-footer__mark" aria-hidden="true"><use href="#lb-blossom" /></svg>© 2026 Alternative World</span>
        <span>"Nếu muốn tìm ra bí mật của vũ trụ, hãy nghĩ về năng lượng, tần số và rung động." — Nikola Tesla</span>
    </div>
</footer>
</UpChrome>
