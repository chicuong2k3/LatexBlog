@page "/search"
@inject PostStore PostStore

<PageTitle>Tìm kiếm — Alternative World</PageTitle>
<header class="lb-page-head">
    <h1>Tìm kiếm</h1>
    <p>Gõ để tìm theo tiêu đề, tóm tắt hoặc thẻ.</p>
</header>
<input type="search"
       name="q"
       class="lb-field"
       placeholder="Tìm kiếm bài viết…"
       autocomplete="off"
       hx-get="/search/results"
       hx-target="#search-results"
       hx-swap="innerHTML"
       hx-trigger="input changed delay:300ms"
       hx-params="q" />
<div id="search-results" class="lb-search-results"></div>
