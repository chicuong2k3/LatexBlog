@page "/profile"
@inject PostStore PostStore
@using System.Text.Json

<PageTitle>Trang cá nhân — Alternative World</PageTitle>

@* Filled from Supabase by the .lb-profile[data-profile] compiler in comments.js. The post list
   rides on data-posts rather than an inline <script>: Unpoly does not run scripts in fragments
   it swaps in. The form is up-submit="false" because comments.js saves it to Supabase. *@
<section class="lb-profile" data-profile data-posts="@PostsJson">
    <p class="lb-comments__hint" data-f="loading"><Spinner /> Đang tải…</p>

    <Empty Class="lb-profile__signin" data-f="signin" hidden>
        <EmptyHeader>
            <EmptyTitle><h1>Trang cá nhân</h1></EmptyTitle>
            <EmptyDescription>Đăng nhập để xem trang cá nhân.</EmptyDescription>
        </EmptyHeader>
        <EmptyContent>
            <Button Type="button" Variant="outline" data-auth-action="sign-in">
                <GoogleMark />
                Đăng nhập bằng Google
            </Button>
        </EmptyContent>
    </Empty>

    <div class="lb-profile__inner" data-f="inner" hidden>
        <Card Class="lb-profile__card">
            <CardHeader>
                <CardTitle><h1>Trang cá nhân</h1></CardTitle>
            </CardHeader>
            <CardContent Class="flex flex-col gap-4">
                <div class="lb-profile__row">
                    <Label Class="lb-avatar-edit" title="Đổi ảnh đại diện">
                        <Avatar Size="lg" Class="size-18">
                            <AvatarImage Class="lb-avatar lb-avatar--lg" data-f="avatar" loading="lazy" />
                        </Avatar>
                        <span class="lb-avatar-edit__overlay">
                            @* Lucide "camera" is not in the library's icon set; drawn inline. *@
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                            Đổi ảnh đại diện
                        </span>
                        <span class="lb-avatar-edit__badge" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                        </span>
                        <Input Class="lb-avatar-edit__file" Type="file" accept="image/*" />
                    </Label>
                    <div class="lb-profile__id">
                        <strong data-f="name"></strong>
                        <span data-f="email"></span>
                    </div>
                </div>

                <form class="lb-profile__form" up-submit="false">
                    <Label Class="lb-field-label" for="lb-name">Tên hiển thị</Label>
                    <Input id="lb-name" Class="lb-field" Type="text" required />
                    <p class="lb-comments__error" data-f="error" hidden></p>
                    <Button Type="submit" data-busy-disable>Lưu</Button>
                </form>

                <div class="lb-profile__stats">
                    <Card Size="sm" Class="lb-stat"><strong data-f="stat-liked">0</strong><span>bài đã thích</span></Card>
                    <Card Size="sm" Class="lb-stat"><strong data-f="stat-comments">0</strong><span>bình luận đã viết</span></Card>
                </div>
                <div class="lb-profile__exports">
                    <Button Type="button" Variant="outline" Size="sm" data-act="export-comments">Tải bình luận (JSON)</Button>
                </div>
            </CardContent>
        </Card>

        <div class="lb-profile__liked">
            <h2>Bài viết đã thích</h2>
            <p class="lb-comments__hint" data-f="liked-empty" hidden>Bạn chưa thích bài viết nào.</p>
            <div class="lb-post-list" data-f="liked-list"></div>
        </div>
    </div>

    <template data-tpl="liked">
        <Card Class="lb-post">
            <span class="lb-post-num"><Icon Name="heart" Class="size-[19px]" style="fill:var(--neon);stroke:var(--neon)" /></span>
            <div class="lb-post-body">
                <h3><a data-f="title"></a></h3>
                <p data-f="summary"></p>
            </div>
            <div class="lb-post-meta"><span class="lb-date" data-f="date"></span></div>
        </Card>
    </template>
</section>

@code {
    private string PostsJson => JsonSerializer.Serialize(
        PostStore.All.Select(p => new { p.Slug, p.Title, p.Summary, p.Date }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
