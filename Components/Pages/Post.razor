@page "/posts/{slug}"
@using System.Text.RegularExpressions
@using System.Text.Json
@inject PostStore PostStore
@inject IHttpContextAccessor HttpContextAccessor

@if (PostMeta is null || (Html is null && DbBody is null))
{
    <PageTitle>Không tìm thấy trang</PageTitle>
    <section class="lb-not-found">
        <h1>Không tìm thấy trang</h1>
        <p>Trang bạn tìm kiếm không tồn tại hoặc đã bị di chuyển.</p>
        <a href="/" class="lb-button">Về trang chủ</a>
    </section>
}
else
{
    <PageTitle>@PostMeta.Title — Alternative World</PageTitle>
    <HeadContent>
        <meta property="og:title" content="@PostMeta.Title" />
        <meta property="og:description" content="@PostMeta.Summary" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="@PostUrl" />
        <meta property="og:image" content="@CoverUrl" />
    </HeadContent>

    <article class="lb-post-page" x-data="annotations" x-init="init('@PostMeta.Slug')">
        <header class="lb-post-head">
            <h1>@PostMeta.Title</h1>
            <p class="lb-post-meta">Đăng ngày @PostMeta.Date · @ReadMinutes phút đọc</p>
            <div class="lb-post-tags">
                @foreach (var tag in PostMeta.Tags)
                {
                    <a href="/tags/@tag" class="lb-tag">#@tag</a>
                }
            </div>
        </header>

        @if (Toc.Count > 0)
        {
            <nav class="lb-toc" x-data="tocSpy" aria-label="Mục lục">
                <strong>Mục lục</strong>
                <ul>
                    @foreach (var entry in Toc)
                    {
                        <li>
                            <a href="#@entry.Id"
                               x-bind:class="activeId === '@entry.Id' ? 'is-active' : ''">@entry.Text</a>
                        </li>
                    }
                </ul>
            </nav>
        }

        @if (Html is not null)
        {
            <div class="lb-prose" x-data x-init="initProse($el)">
                @((MarkupString)Html)
            </div>
        }
        else if (DbBody is not null)
        {
            <div class="lb-prose" x-data x-init="initDbProse($el, @((MarkupString)JsonSerializer.Serialize(DbBody)))"></div>
        }

        <PostActions Slug="@PostMeta.Slug" Title="@PostMeta.Title" />

        @if (Related.Count > 0)
        {
            <aside class="lb-related" aria-label="Bài viết liên quan">
                <h2>Bài viết liên quan</h2>
                <ul class="lb-related__list">
                    @foreach (var p in Related)
                    {
                        <li class="lb-related__item">
                            <a href="/posts/@p.Slug">@p.Title</a>
                            <span class="lb-related__tags">@string.Join(" · ", p.Tags.Select(t => "#" + t))</span>
                        </li>
                    }
                </ul>
            </aside>
        }

        <CommentSection Slug="@PostMeta.Slug" />

        <div class="lb-hlmenu" x-show="menuOpen" :style="'left:' + menuX + 'px; top:' + menuY + 'px'" x-on:click.stop role="menu">
            <button type="button" x-on:click="highlight()">Tô sáng</button>
            <button type="button" x-on:click="openNote()">Ghi chú</button>
            <button type="button" x-on:click="shareQuote()">Chia sẻ đoạn này</button>
        </div>
        <div class="lb-hlnote" x-show="noteOpen" x-on:click.outside="cancelNote()" role="dialog" aria-label="Ghi chú">
            <div class="lb-rte">
                <div class="lb-rte__toolbar" role="toolbar" onmousedown="return false">
                    <button type="button" class="lb-editor__btn" onclick="rteExec(event,'bold')" title="In đậm"><b>B</b></button>
                    <button type="button" class="lb-editor__btn" onclick="rteExec(event,'italic')" title="In nghiêng"><i>I</i></button>
                    <button type="button" class="lb-editor__btn" onclick="rteExec(event,'formatBlock','&lt;pre&gt;')" title="Mã nguồn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
                    <button type="button" class="lb-editor__btn" onclick="rteExec(event,'formatBlock','&lt;blockquote&gt;')" title="Trích dẫn"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M3 21c3-1 4-4 4-8H3v-6h6v6c0 5-2 8-6 8zM15 21c3-1 4-4 4-8h-4v-6h6v6c0 5-2 8-6 8z"/></svg></button>
                    <button type="button" class="lb-editor__btn" onclick="rteExec(event,'insertUnorderedList')" title="Danh sách"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="9" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="9" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg></button>
                    <button type="button" class="lb-editor__btn" onclick="openRteMath(event)" title="Công thức toán"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16M12 8v8M9 12h6"/></svg></button>
                </div>
                <div class="lb-rte__area lb-noteview__edit" contenteditable="true" x-on:input="noteText = $event.currentTarget.innerHTML" placeholder="Viết ghi chú cho đoạn này…"></div>
            </div>
            <div class="lb-hlnote__actions">
                <button type="button" class="lb-button lb-button--sm" x-on:click="saveNote()">Lưu</button>
                <button type="button" class="lb-button lb-button--quiet lb-button--sm" x-on:click="cancelNote()">Hủy</button>
            </div>
        </div>

        <div class="lb-noteview" x-show="noteView" x-on:click.outside="closeNoteView()" role="dialog" aria-label="Ghi chú">
            <template x-if="noteView && !noteEdit">
                <div class="lb-noteview__inner">
                    <div class="lb-noteview__body" x-html="renderNote(noteView.note)"></div>
                    <div class="lb-noteview__actions">
                        <button type="button" class="lb-button lb-button--sm" x-on:click="startEditNote()">Sửa</button>
                        <button type="button" class="lb-button lb-button--quiet lb-button--sm" x-on:click="closeNoteView()">Đóng</button>
                    </div>
                </div>
            </template>
            <template x-if="noteView && noteEdit">
                <div class="lb-noteview__inner">
                    <div class="lb-rte">
                        <div class="lb-rte__toolbar" role="toolbar" onmousedown="return false">
                            <button type="button" class="lb-editor__btn" onclick="rteExec(event,'bold')" title="In đậm"><b>B</b></button>
                            <button type="button" class="lb-editor__btn" onclick="rteExec(event,'italic')" title="In nghiêng"><i>I</i></button>
                            <button type="button" class="lb-editor__btn" onclick="rteExec(event,'formatBlock','&lt;pre&gt;')" title="Mã nguồn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
                            <button type="button" class="lb-editor__btn" onclick="rteExec(event,'formatBlock','&lt;blockquote&gt;')" title="Trích dẫn"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M3 21c3-1 4-4 4-8H3v-6h6v6c0 5-2 8-6 8zM15 21c3-1 4-4 4-8h-4v-6h6v6c0 5-2 8-6 8z"/></svg></button>
                            <button type="button" class="lb-editor__btn" onclick="rteExec(event,'insertUnorderedList')" title="Danh sách"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="9" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="9" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg></button>
                            <button type="button" class="lb-editor__btn" onclick="openRteMath(event)" title="Công thức toán"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16M12 8v8M9 12h6"/></svg></button>
                        </div>
                        <div class="lb-rte__area lb-noteview__edit" contenteditable="true" x-init="$el.innerHTML = noteEditHtml" x-on:input="noteEditHtml = $event.currentTarget.innerHTML"></div>
                    </div>
                    <div class="lb-noteview__actions">
                        <button type="button" class="lb-button lb-button--sm" x-on:click="saveEditNote()">Lưu</button>
                        <button type="button" class="lb-button lb-button--quiet lb-button--sm" x-on:click="noteEdit = false">Hủy</button>
                    </div>
                </div>
            </template>
        </div>
    </article>
}

@code {
    private static readonly Regex HeadingRegex = new(
        @"<h([1-3])\s+id=""([^""]+)""[^>]*>(.*?)</h\1>",
        RegexOptions.IgnoreCase | RegexOptions.Singleline);

    [Parameter] public string? Slug { get; set; }

    private PostMeta? PostMeta;
    private string? Html;
    private string? DbBody;
    private List<TocEntry> Toc { get; } = new();

    private string PostUrl =>
        PostMeta is null || HttpContextAccessor.HttpContext is not { } ctx
            ? "/"
            : $"{ctx.Request.Scheme}://{ctx.Request.Host}/posts/{PostMeta.Slug}";

    private string CoverUrl =>
        PostMeta is null || HttpContextAccessor.HttpContext is not { } ctx
            ? ""
            : $"{ctx.Request.Scheme}://{ctx.Request.Host}/cover/{PostMeta.Slug}.svg";

    private int ReadMinutes
    {
        get
        {
            var text = DbBody ?? (Html is null ? "" : Regex.Replace(Html, "<[^>]+>", " "));
            var words = Regex.Matches(text, @"\S+").Count;
            return Math.Max(1, (int)Math.Ceiling(words / 200.0));
        }
    }

    private IReadOnlyList<PostMeta> Related =>
        PostMeta is null
            ? Array.Empty<PostMeta>()
            : PostStore.All
                .Where(p => p.Slug != PostMeta.Slug &&
                            p.Tags.Any(t => PostMeta.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)))
                .OrderByDescending(p => p.Tags.Count(t => PostMeta.Tags.Contains(t, StringComparer.OrdinalIgnoreCase)))
                .ThenBy(p => p.Date)
                .Take(3)
                .ToList();

    protected override void OnParametersSet()
    {
        PostMeta = Slug is null ? null : PostStore.GetMeta(Slug);
        Html = PostMeta is null ? null : PostStore.GetHtml(PostMeta.Slug);
        DbBody = PostMeta is null ? null : PostStore.GetDbBody(PostMeta.Slug);
        Toc.Clear();
        if (Html is not null)
            Toc.AddRange(ExtractToc(Html));
        if (PostMeta is null && HttpContextAccessor.HttpContext is { } ctx)
            ctx.Response.StatusCode = StatusCodes.Status404NotFound;
    }

    private static IEnumerable<TocEntry> ExtractToc(string html)
    {
        foreach (Match m in HeadingRegex.Matches(html))
        {
            var text = Regex.Replace(m.Groups[3].Value, "<[^>]+>", "");
            text = System.Net.WebUtility.HtmlDecode(text).Trim();
            if (text.Length == 0)
                continue;
            yield return new TocEntry(m.Groups[2].Value, text);
        }
    }

    private sealed record TocEntry(string Id, string Text);
}
