<section class="lb-music" data-lb-music aria-label="Trình phát nhạc">
    <div class="lb-music__cover" aria-hidden="true">
        <span class="lb-music__orb"></span>
        <span class="lb-music__note">♪</span>
    </div>
    <div class="lb-music__meta">
        <span class="lb-music__eyebrow">Đang tạo không khí</span>
        <strong data-lb-music-title>Sakura Ambient</strong>
        <span data-lb-music-state>Âm thanh tổng hợp · không tải tệp</span>
    </div>
    <div class="lb-music__controls">
        <button type="button" class="lb-music__play" data-lb-music-play aria-label="Phát nhạc">
            <svg data-lb-music-icon viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 10 7-10 7V5Z" /></svg>
        </button>
        <div class="lb-music__timeline"><span data-lb-music-progress></span></div>
        <span class="lb-music__time" data-lb-music-time>00:00</span>
        <label class="lb-music__volume" aria-label="Âm lượng">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Zm-2.5-7.8v2.1a7 7 0 0 1 0 11.4v2.1a9 9 0 0 0 0-15.6Z" /></svg>
            <input type="range" min="0" max="1" step=".01" value=".18" data-lb-music-volume />
        </label>
    </div>
</section>
