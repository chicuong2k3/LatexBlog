@page "/write"
@using LatexBlog.I18n

<PageTitle>@I18n.PostEditor — @I18n.SiteTitle</PageTitle>

<section class="lb-write" x-data="postEditor" x-init="init()">
    <p class="lb-comments__hint" x-show="!ready">@I18n.Loading</p>

    <template x-if="ready && !$store.auth.signedIn">
        <div class="lb-profile__signin">
            <h1>@I18n.PostEditor</h1>
            <p>@I18n.ProfileSignIn</p>
            <button type="button" class="lb-button" x-on:click="$store.auth.signIn()">
                <svg class="lb-comments__g" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                @I18n.SignInGoogle
            </button>
        </div>
    </template>

    <template x-if="ready && $store.auth.signedIn && !$store.auth.isAdmin">
        <div class="lb-profile__signin">
            <h1>@I18n.PostEditor</h1>
            <p>@I18n.NoAdmin</p>
        </div>
    </template>

    <template x-if="ready && $store.auth.signedIn && $store.auth.isAdmin">
        <div class="lb-write__inner">
            <div class="lb-write__head">
                <h1 x-text="editingSlug ? '@I18n.Edit: ' + title : '@I18n.PostEditor'"></h1>
                <button type="button" class="lb-button lb-button--sm" x-on:click="newPost()">@I18n.WritePost</button>
            </div>

            <form class="lb-write__form" x-on:submit.prevent="save()">
                <label class="lb-field-label" for="w-title">@I18n.TitleLabel</label>
                <input id="w-title" class="lb-field" type="text" x-model="title" required />

                <div class="lb-write__cols">
                    <div>
                        <label class="lb-field-label" for="w-slug">@I18n.Slug</label>
                        <input id="w-slug" class="lb-field" type="text" x-model="slug" required />
                    </div>
                    <div>
                        <label class="lb-field-label" for="w-date">@I18n.PostDate</label>
                        <input id="w-date" class="lb-field" type="date" x-model="date" required />
                    </div>
                </div>

                <label class="lb-field-label" for="w-tags">@I18n.PostTags</label>
                <input id="w-tags" class="lb-field" type="text" x-model="tags" placeholder="toan, latex" />

                <label class="lb-field-label" for="w-summary">@I18n.Summary</label>
                <textarea id="w-summary" class="lb-field" x-model="summary" rows="2"></textarea>

                <label class="lb-field-label">@I18n.BodyMarkdown</label>
                <div class="lb-editor">
                    <div class="lb-editor__toolbar" role="toolbar">
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '**', '**')" title="@I18n.Bold"><b>B</b></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '*', '*')" title="@I18n.Italic"><i>I</i></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '`', '`')" title="@I18n.Code"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '$', '$')" title="@I18n.InlineMath"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16M12 8v8M9 12h6"/></svg></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '\n$$\n', '\n$$\n')" title="@I18n.DisplayMath"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6H6l7 6-7 6h12"/></svg></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '[', '](https://)')" title="@I18n.Link"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '> ', '')" title="@I18n.Quote"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 21c3-1 4-4 4-8H3v-6h6v6c0 5-2 8-6 8zM15 21c3-1 4-4 4-8h-4v-6h6v6c0 5-2 8-6 8z"/></svg></button>
                        <button type="button" class="lb-editor__btn" x-on:click="insert($event, '- ', '')" title="@I18n.List"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="9" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="9" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg></button>
                        <button type="button" class="lb-editor__btn lb-editor__btn--push" x-on:click="togglePreview()">@I18n.Preview</button>
                    </div>
                    <textarea class="lb-field lb-comments__box lb-editor__input" x-model="body" rows="14" placeholder="Markdown + $toán$"></textarea>
                    <div class="lb-editor__preview" x-show="preview" x-html="previewHtml"></div>
                </div>

                <label class="lb-write__pub"><input type="checkbox" x-model="published" /> @I18n.Publish</label>

                <p class="lb-comments__error" x-show="error" x-text="error"></p>
                <div class="lb-write__actions">
                    <button type="submit" class="lb-button" :disabled="saving">@I18n.Save</button>
                    <a class="lb-button lb-button--quiet" href="/ping-sitemap">@I18n.PingSitemap</a>
                </div>
            </form>

            <div class="lb-write__list">
                <h2>@I18n.DbPosts</h2>
                <template x-if="!posts.length">
                    <p class="lb-comments__hint">@I18n.NoPosts</p>
                </template>
                <template x-for="p in posts" :key="p.slug">
                    <div class="lb-write__row">
                        <div class="lb-write__rowinfo">
                            <strong x-text="p.title"></strong>
                            <span class="lb-write__meta" x-text="p.date + ' · ' + (p.published ? '@I18n.Publish' : 'draft')"></span>
                        </div>
                        <div class="lb-write__rowbtns">
                            <a class="lb-comment__reply" :href="'/posts/' + p.slug">@I18n.ReadMore</a>
                            <button type="button" class="lb-comment__reply" x-on:click="edit(p)">@I18n.Edit</button>
                            <button type="button" class="lb-comment__reply" x-on:click="remove(p)">@I18n.Delete</button>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </template>
</section>
