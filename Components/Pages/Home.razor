@page "/"
@using System.Text.Json.Nodes
@inject PostStore PostStore
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Alternative World</PageTitle>
<HeadContent>
    <script type="application/ld+json">@((MarkupString)WebsiteJsonLd)</script>
</HeadContent>

<section class="lb-hero">
    <div class="lb-sweep" aria-hidden="true"></div>
    <div class="lb-wrap">
        <h1>"Nếu tôi nhìn được <span class="lb-neon">xa hơn</span>, đó là vì đứng trên vai những người <span class="lb-violet">khổng lồ</span>." <cite>— Isaac Newton</cite></h1>
        <p class="lb-hero-lead">Nhìn thế giới qua một lăng kính khác.</p>

        <div class="lb-matrix" aria-label="Tần số cộng hưởng mạch LC, không thuộc bài viết bên dưới" x-data x-init="initProse($el)">
            <span class="lb-flag">Công thức trong ngày</span>
            <div class="lb-matrix-box">
                <span class="math display">f = \dfrac{1}{2\pi\sqrt{LC}}</span>
            </div>
        </div>

        @if (Latest is not null)
        {
            <article class="lb-featured">
                <div>
                    <span class="lb-flag">Bài mới nhất</span>
                    <h2><a href="/posts/@Latest.Slug">@Latest.Title</a></h2>
                    <p>@Latest.Summary</p>
                    <a class="lb-cta" href="/posts/@Latest.Slug">Đọc tiếp
                        <svg width="16" height="16" aria-hidden="true"><use href="#lb-arrow" /></svg>
                    </a>
                </div>
            </article>
        }
    </div>
</section>

<section class="lb-posts">
    <div class="lb-wrap">
        <div class="lb-posts-head">
            <h2>Bài viết</h2>
            <span class="lb-count">@PostStore.All.Count bài</span>
        </div>
        <div class="lb-post-list">
            @{ var idx = 0; }
            @foreach (var post in PagePosts)
            {
                idx++;
                <PostCard Post="post" Number="idx" />
            }
        </div>
        @if (HasMore)
        {
            <div id="load-more" class="lb-load-more">
                <button type="button" class="lb-button"
                        hx-get="/posts?page=2"
                        hx-target="#load-more"
                        hx-swap="outerHTML"
                        hx-push-url="false">Xem thêm</button>
            </div>
        }
    </div>
</section>

<section class="lb-tagcloud">
    <div class="lb-wrap">
        <div class="lb-posts-head">
            <h2>Thẻ</h2>
        </div>
        <div class="lb-tagcloud__chips">
            @foreach (var tc in TagCounts)
            {
                <a href="/tags/@tc.Tag" class="lb-tag lb-tag--big">@tc.Tag <span>@tc.Count</span></a>
            }
        </div>
    </div>
</section>

@code {
    private const int PageSize = 3;

    private string WebsiteJsonLd
    {
        get
        {
            var baseUrl = HttpContextAccessor.HttpContext is { } ctx
                ? $"{ctx.Request.Scheme}://{ctx.Request.Host}"
                : "";
            var node = new JsonObject
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "WebSite",
                ["name"] = "Alternative World",
                ["url"] = baseUrl,
                ["description"] = "Blog toán học và lập trình viết bằng LaTeX, nhìn thế giới qua một lăng kính khác.",
                ["inLanguage"] = "vi",
                ["publisher"] = new JsonObject { ["@type"] = "Organization", ["name"] = "Alternative World" },
            };
            return node.ToJsonString();
        }
    }

    private PostMeta? Latest => PostStore.All.FirstOrDefault();

    private IReadOnlyList<PostMeta> PagePosts =>
        PostStore.All.Take(PageSize).ToList();

    private bool HasMore => PostStore.All.Count > PageSize;

    private sealed record TagCount(string Tag, int Count);

    private IReadOnlyList<TagCount> TagCounts =>
        PostStore.All.SelectMany(p => p.Tags)
                     .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
                     .Select(g => new TagCount(g.Key, g.Count()))
                     .OrderBy(x => x.Tag, StringComparer.OrdinalIgnoreCase)
                     .ToList();
}
