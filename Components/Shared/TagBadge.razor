@* A post tag as a shadcn Badge link. *@
<Badge Href="@($"/tags/{Tag}")" Variant="secondary" Class="@(Big ? "lb-tag lb-tag--big" : "lb-tag")">@Tag@ChildContent</Badge>

@code {
    [Parameter, EditorRequired] public string Tag { get; set; } = default!;
    [Parameter] public bool Big { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
