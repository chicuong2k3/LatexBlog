@using LatexBlog.Services

<article class="lb-post">
    <span class="lb-post-num" aria-hidden="true">@Number.ToString("00")</span>
    <div class="lb-post-body">
        <h3><a href="/posts/@Post.Slug">@Post.Title</a></h3>
        <p>@Post.Summary</p>
    </div>
    <div class="lb-post-meta">
        <span class="lb-date">Đăng ngày @Post.Date</span>
        <div class="lb-post-tags">
            @foreach (var tag in Post.Tags)
            {
                <a href="/tags/@tag" class="lb-tag">@tag</a>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public PostMeta Post { get; set; } = default!;
    [Parameter] public int Number { get; set; } = 0;
}
