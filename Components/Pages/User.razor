@page "/u/{Id}"

<PageTitle>Trang cá nhân — Alternative World</PageTitle>

@* Filled from Supabase by the .lb-profile[data-user-id] compiler in comments.js. *@
<section class="lb-profile" data-user-id="@Id">
    <p class="lb-comments__hint" data-f="loading"><Spinner /> Đang tải…</p>

    <Empty Class="lb-profile__signin" data-f="missing" hidden>
        <EmptyHeader>
            <EmptyTitle><h1>Không tìm thấy người dùng</h1></EmptyTitle>
        </EmptyHeader>
        <EmptyContent>
            <Button Href="/" Variant="link" Class="lb-cta">Về trang chủ</Button>
        </EmptyContent>
    </Empty>

    <div class="lb-profile__inner" data-f="found" hidden>
        <Card Class="lb-profile__card">
            <CardContent Class="lb-profile__row">
                <Avatar Size="lg" Class="size-18">
                    <AvatarImage Class="lb-avatar lb-avatar--lg" data-f="avatar" loading="lazy" />
                </Avatar>
                <div>
                    <h1 data-f="name"></h1>
                    <p class="lb-comments__who"><span data-f="count">0</span> bình luận đã viết</p>
                </div>
            </CardContent>
        </Card>

        <Card Class="lb-profile__card">
            <CardHeader>
                <CardTitle><h2>Bình luận gần đây</h2></CardTitle>
            </CardHeader>
            <CardContent>
                <p class="lb-comments__hint" data-f="none" hidden>Chưa có bình luận nào.</p>
                <ul class="lb-comments__list" data-f="list"></ul>
            </CardContent>
        </Card>
    </div>

    <template data-tpl="comment">
        <li class="lb-comment">
            <div class="lb-comment__body" data-f="body"></div>
            <div class="lb-comment__actions">
                <Button Href="#" Variant="outline" Size="xs" Class="lb-comment__reply" data-f="link">Xem trong bài</Button>
                <time class="lb-comment__when" data-f="when"></time>
            </div>
        </li>
    </template>
</section>

@code {
    [Parameter] public string Id { get; set; } = "";
}
