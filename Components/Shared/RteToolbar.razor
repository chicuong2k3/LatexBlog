@* Formatting toolbar for the contenteditable editors (comments, replies, notes).
   comments.js runs the command named by data-rte-cmd / data-rte-val through one delegated
   click listener, and toggles .is-active from the same attributes.
   Lucide "code", "quote" and "list" are not in the library's icon set, so those glyphs stay inline. *@
<ButtonGroup Class="lb-rte__toolbar" role="toolbar" aria-label="@Label">
    <Button Type="button" Variant="ghost" Size="icon-xs" Class="lb-editor__btn" data-rte-cmd="bold" title="In đậm">
        <Icon Name="bold" />
    </Button>
    <Button Type="button" Variant="ghost" Size="icon-xs" Class="lb-editor__btn" data-rte-cmd="italic" title="In nghiêng">
        <Icon Name="italic" />
    </Button>
    <Button Type="button" Variant="ghost" Size="icon-xs" Class="lb-editor__btn" data-rte-cmd="formatBlock" data-rte-val="<pre>" title="Mã nguồn">
        <svg width="@IconSize" height="@IconSize" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
    </Button>
    <Button Type="button" Variant="ghost" Size="icon-xs" Class="lb-editor__btn" data-rte-cmd="formatBlock" data-rte-val="<blockquote>" title="Trích dẫn">
        <svg width="@IconSize" height="@IconSize" viewBox="0 0 24 24" fill="currentColor"><path d="M3 21c3-1 4-4 4-8H3v-6h6v6c0 5-2 8-6 8zM15 21c3-1 4-4 4-8h-4v-6h6v6c0 5-2 8-6 8z"/></svg>
    </Button>
    <Button Type="button" Variant="ghost" Size="icon-xs" Class="lb-editor__btn" data-rte-cmd="insertUnorderedList" title="Danh sách">
        <svg width="@IconSize" height="@IconSize" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="9" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="9" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1" fill="currentColor"/><circle cx="4" cy="12" r="1" fill="currentColor"/><circle cx="4" cy="18" r="1" fill="currentColor"/></svg>
    </Button>
</ButtonGroup>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public int IconSize { get; set; } = 13;
}
