@inherits LayoutComponentBase

@* Behaviour lives in wwwroot/js (site.js: nav, comment search; comments.js: auth, notifications),
   bound through up.compiler on the classes / data-* hooks below. *@
<UpChrome Provides=".lb-nav, .lb-notif__badge">
<div class="lb-nav">
    <div id="lb-progress" class="lb-progress" aria-hidden="true"></div>
    <nav class="lb-wrap lb-nav-in">
        <a href="/" class="lb-brand">
            <svg class="lb-brand__mark" aria-hidden="true"><use href="#lb-blossom" /></svg>
            AIM
        </a>

        <Button Type="button" Variant="ghost" Size="icon" Class="lb-nav__toggle"
                data-lb-menu-toggle aria-expanded="false" aria-label="Mở menu">
            <Icon Name="menu" Class="size-5" />
        </Button>

        <div class="lb-nav-panel">
        <ul class="lb-nav-links">
            <li><Button Href="/" Variant="link" Size="sm" Class="px-0">Trang chủ</Button></li>
            <li><Button Href="/tags" Variant="link" Size="sm" Class="px-0">Thẻ</Button></li>
            <li><Button Href="/books" Variant="link" Size="sm" Class="px-0">Dịch sách</Button></li>
            <li><Button Href="/about" Variant="link" Size="sm" Class="px-0">Về tôi</Button></li>
        </ul>

        <div class="lb-nav-right">
            <Button Type="button" Variant="outline" Size="icon-sm" Class="lb-nav-icon lb-search-trigger"
                    data-command-open="lb-search" aria-label="Tìm kiếm (Ctrl+K)">
                <Icon Name="search" />
            </Button>

            <div class="lb-notif" data-auth="in" hidden>
                <Button Type="button" Variant="ghost" Size="icon-sm" Class="lb-nav-icon"
                        data-act="notif-toggle" aria-expanded="false" aria-label="Thông báo">
                    @* Lucide "bell" is not in the library's icon set; drawn inline. *@
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <Badge Class="lb-notif__badge" hidden></Badge>
                </Button>
                <Card Class="lb-notif__panel gap-0 py-0" role="menu" aria-label="Thông báo" hidden>
                    <CardHeader Class="lb-notif__head">
                        <CardTitle>Thông báo</CardTitle>
                        <CardAction>
                            <Button Type="button" Variant="link" Size="xs" Class="lb-notif__readall" data-act="read-all" hidden>Đọc hết</Button>
                        </CardAction>
                    </CardHeader>
                    <p class="lb-notif__empty" data-f="empty">Chưa có thông báo.</p>
                    <div data-f="items"></div>
                    <template data-tpl="notif">
                        <Item Href="#" Size="sm" Class="lb-notif__item">
                            <ItemMedia>
                                <Avatar Size="sm" Class="size-[26px]">
                                    <AvatarImage Class="lb-avatar lb-avatar--xs" data-f="avatar" loading="lazy" />
                                </Avatar>
                            </ItemMedia>
                            <ItemContent Class="lb-notif__text">
                                <ItemTitle data-f="name"></ItemTitle>
                                <ItemDescription data-f="text"></ItemDescription>
                            </ItemContent>
                            <time data-f="when"></time>
                        </Item>
                    </template>
                </Card>
            </div>

            <Button Type="button" Variant="outline" Size="sm" Class="lb-nav-login" data-auth="out" data-auth-action="sign-in" aria-label="Đăng nhập" hidden>
                <GoogleMark Size="16" />
                <span class="lb-nav-login__text">Đăng nhập</span>
            </Button>
            <div class="lb-nav-user" data-auth="in" hidden>
                <Button Href="/profile" Variant="ghost" Size="sm" Class="lb-nav-user__link">
                    <Avatar Size="sm" Class="size-[26px]">
                        <AvatarImage Class="lb-avatar" data-auth-src="avatar" loading="lazy" />
                    </Avatar>
                    <span class="lb-nav-user__name" data-auth-text="displayName"></span>
                </Button>
                <Button Type="button" Variant="ghost" Size="icon-sm" Class="lb-nav-icon" data-auth-action="sign-out" aria-label="Đăng xuất" title="Đăng xuất">
                    <Icon Name="log-out" />
                </Button>
            </div>

        </div>
        </div>
    </nav>

    @* Search as a command palette (Unpoly.Blazor.Shadcn CommandDialog): every post and book is already
       here as a link, and ui.js filters them as you type — no round trip, no /search page.
       Keywords add the summary, the tags and a đ→d copy of the title, because the filter folds
       diacritics but đ is its own letter. Comment matches come from Supabase (site.js) into
       the "Bình luận" group, and the same filter then shows them. ⌘K / Ctrl+K or "/" opens it. *@
    <CommandDialog Id="lb-search" Key="mod+k" Title="Tìm kiếm"
                   Description="Tìm bài viết, sách dịch hoặc bình luận.">
        <CommandInput Placeholder="Tìm bài viết, sách, thẻ hoặc bình luận…" AriaLabel="Tìm kiếm" />
        <CommandList>
            <CommandEmpty Class="py-8 text-center text-sm text-muted-foreground">Không tìm thấy gì.</CommandEmpty>
            <CommandGroup Heading="Bài viết">
                @foreach (var post in PostStore.All)
                {
                    <CommandItem Href="@($"/posts/{post.Slug}")" Keywords="@Keywords(post)">
                        <Icon Name="file-text" />
                        <span class="truncate">@post.Title</span>
                    </CommandItem>
                }
            </CommandGroup>
            <CommandGroup Heading="Sách dịch">
                @foreach (var book in BookStore.All)
                {
                    <CommandItem Href="@($"/books/{book.Slug}")" Keywords="@BookKeywords(book)">
                        <Icon Name="bookmark" />
                        <span class="truncate">@book.Title</span>
                    </CommandItem>
                }
            </CommandGroup>
            <CommandGroup Heading="Bình luận" data-lb-cresults></CommandGroup>
        </CommandList>
        <template data-tpl="cresult">
            <CommandItem Href="#">
                <Icon Name="message-circle" />
                <span class="flex min-w-0 flex-col">
                    <span class="truncate" data-f="body"></span>
                    <span class="truncate text-xs text-muted-foreground" data-f="meta"></span>
                </span>
            </CommandItem>
        </template>
    </CommandDialog>

</div>


</UpChrome>

<Button Type="button" Variant="outline" Size="icon" id="lb-top" Class="lb-top" aria-label="Về đầu trang">
    <Icon Name="arrow-up" />
</Button>

<main class="lb-wrap lb-main">
    @Body
</main>



@code {
    [Inject] private PostStore PostStore { get; set; } = default!;
    [Inject] private BookStore BookStore { get; set; } = default!;

    private static string Keywords(PostMeta post) =>
        string.Join(' ', new[]
        {
            post.Summary,
            string.Join(' ', post.Tags),
            string.Join(' ', post.Tags).Replace('-', ' '), // "dai so" should find tag dai-so-tuyen-tinh
            post.Title.Replace('đ', 'd').Replace('Đ', 'D'),
        });

    private static string BookKeywords(BookMeta book) =>
        string.Join(' ', new[]
        {
            book.Summary,
            book.Author ?? string.Empty,
            book.OriginalTitle ?? string.Empty,
            string.Join(' ', book.Tags),
            string.Join(' ', book.Tags).Replace('-', ' '),
            book.Title.Replace('đ', 'd').Replace('Đ', 'D'),
        });
}
