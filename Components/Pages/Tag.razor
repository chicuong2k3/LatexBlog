@page "/tags/{tag}"
@inject PostStore PostStore

<PageTitle>#@CurrentTag - Alternative World</PageTitle>
<HeadContent>
    <script type="module" src="/js/page-layout.js?v=20260821a"
            data-page-layout
            data-masonry="#tag-list .lb-post-list"
            data-heading=".lb-page-head h1"></script>
</HeadContent>
<header class="lb-page-head">
    <h1>Bài viết theo thẻ: #@CurrentTag</h1>
    <div class="lb-chips">
        @foreach (var tag in AllTags)
        {
            <a href="/tags/@tag" class="lb-tag"
               hx-get="/tags?tag=@tag"
               hx-target="#tag-list"
               hx-push-url="false">@tag</a>
        }
    </div>
</header>
<TagList Tag="@CurrentTag" />

@code {
    [Parameter] public string? tag { get; set; }

    private string CurrentTag => tag ?? "";

    private IReadOnlyList<string> AllTags =>
        PostStore.All.SelectMany(p => p.Tags)
                     .Distinct(StringComparer.OrdinalIgnoreCase)
                     .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                     .ToList();
}
