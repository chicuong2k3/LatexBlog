<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Unpoly.Blazor ships as a submodule under external/ and is built via the
         ProjectReference below; keep the SDK from compiling its sources
         (src/sample/tests/templates) into this app as well. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);external\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="external\Unpoly.Blazor\src\Unpoly.Blazor\Unpoly.Blazor.csproj" />
    <ProjectReference Include="external\Unpoly.Blazor.Shadcn\src\Unpoly.Blazor.Shadcn\Unpoly.Blazor.Shadcn.csproj" />
  </ItemGroup>

  <Target Name="BuildPosts" BeforeTargets="BeforeBuild">
    <Exec Command="python tools/build_posts.py" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- Tailwind v4 compiles Styles/app.css (shadcn tokens + every class the components use)
       into wwwroot/css/app.css. Skipped under `dotnet watch`; run `npm run css:watch` there. -->
  <Target Name="NpmInstall" BeforeTargets="Tailwind"
          Condition="!Exists('node_modules') And '$(SkipTailwind)' != 'true'">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="Tailwind" BeforeTargets="BeforeBuild"
          Condition="'$(SkipTailwind)' != 'true' And '$(DotNetWatchBuild)' != 'true'">
    <Exec Command="npm run css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
